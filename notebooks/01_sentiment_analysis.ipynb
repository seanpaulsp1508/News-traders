# Jupyter Notebook for sentiment analysis exploration
"""
# News Sentiment Analysis Demo

This notebook demonstrates the sentiment analysis capabilities of the news trading platform.
"""

import sys
sys.path.append('..')

from src.news_analysis.sentiment_analyzer import AdvancedSentimentAnalyzer
from src.news_analysis.news_collector import NewsCollector
import pandas as pd
import matplotlib.pyplot as plt

# Initialize components
analyzer = AdvancedSentimentAnalyzer()
collector = NewsCollector()

# Collect sample news
news_df = collector.fetch_news(['AAPL', 'GOOGL', 'MSFT'])

# Analyze sentiment
results_df = analyzer.analyze_news_batch(news_df)

# Visualize results
plt.figure(figsize=(12, 6))
for symbol in results_df['symbol'].unique():
    symbol_data = results_df[results_df['symbol'] == symbol]
    plt.plot(symbol_data['analysis_timestamp'], symbol_data['combined_sentiment'], 
             label=symbol, marker='o')

plt.title('News Sentiment Over Time')
plt.xlabel('Time')
plt.ylabel('Sentiment Score')
plt.legend()
plt.grid(True)
plt.show()
